{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "skyline-stack",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Start a new skyline",
        "description": "Open today's Skyline stack challenge",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Clear Skyline floor tags",
        "description": "Remove today's visible floor labels from this Skyline post",
        "location": "post",
        "postFilter": "currentApp",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/clear-floor-tags"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "forms": {
    "shareResult": "/internal/form/share-result"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "skyline_stack_dev"
  }
}