{
  "private": true,
  "name": "skyline-subreddit-stack",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run harness:check && npm run type-check && npm run lint && devvit upload",
    "dev": "devvit playtest",
    "launch": "npm run deploy && devvit publish",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "type-check": "tsc --build",
    "harness:check": "node scripts/harness-check.mjs",
    "brief": "sed -n '1,220p' harness/01-hackathon-brief.md",
    "resources": "sed -n '1,260p' harness/06-resources.md"
  },
  "engines": {
    "node": ">=22.2.0"
  },
  "dependencies": {
    "@devvit/start": "^0.13.7",
    "@devvit/web": "^0.13.7",
    "@hono/node-server": "2.0.3",
    "devvit": "^0.13.7",
    "hono": "4.12.21",
    "phaser": "4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.19.19",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "playwright": "^1.61.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.4"
  }
}
